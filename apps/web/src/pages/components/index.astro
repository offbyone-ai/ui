---
import { getCollection } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";

const components = await getCollection("components");
---

<DocsLayout title="Components">
	<div class="mb-8">
		<h1 class="mb-2 text-4xl font-bold">Components</h1>
		<p class="text-muted-foreground">
			Browse and install components from the offbyone registry.
		</p>
	</div>

	<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
		{components.map((component) => (
			<a
				href={`/components/${component.data.component}`}
				class="group rounded-lg border p-6 transition-colors hover:bg-muted/50"
			>
				<h2 class="mb-2 font-semibold group-hover:underline">
					{component.data.title}
				</h2>
				<p class="mb-4 text-sm text-muted-foreground">
					{component.data.description}
				</p>
			</a>
		))}
	</div>
</DocsLayout>
